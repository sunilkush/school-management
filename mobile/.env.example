# Copy to .env and set the address of the backend.
#
# On a phone, `localhost` means THE PHONE, not the machine running the backend — so the default
# below only works on an emulator sharing the host's loopback. Use your machine's LAN IP:
#   Windows:  ipconfig            (look for the IPv4 address)
#   macOS:    ipconfig getifaddr en0
#
# After changing this file you MUST restart Metro with its cache cleared:
#   npx expo start -c
# Expo inlines EXPO_PUBLIC_* values at bundle time and Metro caches the result, so a plain restart
# keeps serving the OLD address. The startup log should say `env: load .env`.
#
# The phone and the backend machine must also be on the same network, and the backend's port has
# to be reachable — on Windows that usually means allowing Node through the firewall once.

EXPO_PUBLIC_API_URL=http://localhost:9000/api/v1
