# ── Server ────────────────────────────────────────────────────────────────────
PORT=9000
NODE_ENV=production

# ── Database ──────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string
MONGOOSE_URI=mongodb+srv://<user>:<password>@cluster0.xxwzkn3.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0

# ── JWT (generate with: node -e "require('crypto').randomBytes(64).toString('hex')" )
ACCESS_TOKEN_SECRET=<64-byte-hex-string>
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=<64-byte-hex-string>
REFRESH_TOKEN_EXPIRY=10d

# ── Frontend / CORS ────────────────────────────────────────────────────────────
# Your deployed frontend URL (no trailing slash)
CLIENT_URL=https://your-frontend-domain.vercel.app
FRONTEND_URL=https://your-frontend-domain.vercel.app
ORIGIN_URI=https://your-frontend-domain.vercel.app

# ── Cloudinary (image/file uploads) ───────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>

# ── Email (optional — for notifications) ──────────────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# ── SMS & WhatsApp (optional — via Twilio) ─────────────────────────────────────
# Delivers the "SMS" and "WhatsApp" notification channels via Twilio. Both share the same
# account credentials but use different sender numbers. Without these set, sends are a no-op —
# notifications still create/deliver in-app, they just skip the SMS/WhatsApp channels.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=<your-auth-token>
# TWILIO_PHONE_NUMBER=+15551234567
# TWILIO_WHATSAPP_NUMBER=+14155238886

# ── Push notifications (optional — Firebase Cloud Messaging) ──────────────────
# Delivers to Android directly via FCM and to iOS via FCM's APNs relay (configure your APNs auth
# key under Firebase Console → Project Settings → Cloud Messaging → Apple app configuration).
# Paste the ENTIRE service account JSON (Firebase Console → Project Settings → Service Accounts →
# Generate new private key) as a single-line string. Without this set, push sends are a no-op —
# notifications still create/deliver in-app, they just skip the push channel.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...", ...}
