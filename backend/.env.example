# ── Server ────────────────────────────────────────────────────────────────────
PORT=9000
NODE_ENV=production

# ── Database ──────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string
MONGOOSE_URI=mongodb+srv://<user>:<password>@cluster0.xxwzkn3.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0

# ── JWT (generate with: node -e "require('crypto').randomBytes(64).toString('hex')" )
ACCESS_TOKEN_SECRET=<64-byte-hex-string>
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=<64-byte-hex-string>
REFRESH_TOKEN_EXPIRY=10d

# ── Frontend / CORS ────────────────────────────────────────────────────────────
# Your deployed frontend URL (no trailing slash)
CLIENT_URL=https://your-frontend-domain.vercel.app
FRONTEND_URL=https://your-frontend-domain.vercel.app
ORIGIN_URI=https://your-frontend-domain.vercel.app

# ── Cloudinary (image/file uploads) ───────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>

# ── Email (optional — for notifications) ──────────────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
